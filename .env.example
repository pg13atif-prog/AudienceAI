# AI Provider API Keys (Configure at least one for live simulation)
# 1. Google Gemini API (Recommended direct provider: https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud API (Ultra-fast fallback: https://console.groq.com/)
VITE_GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter API (Multi-model gateway: https://openrouter.ai/)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

